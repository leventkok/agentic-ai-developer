# HTTP server port
PORT=8080

# gRPC server port
GRPC_PORT=9090

# Database path
DB_PATH=bookmarks.db

# Connection pool (SQLite: keep MaxOpenConns=1)
DB_MAX_OPEN_CONNS=1
DB_MAX_IDLE_CONNS=1
DB_CONN_MAX_LIFETIME_MIN=0

# JWT signing (change JWT_SECRET in production)
JWT_SECRET=dev-only-change-me-in-production
JWT_TTL_HOURS=24

# Brute-force protection on auth routes
AUTH_RATE_LIMIT_PER_MIN=10

# Optional Redis cache (empty = in-memory cache)
REDIS_URL=
CACHE_TTL_SEC=60

# NATS (empty = in-memory bus, synchronous handlers in API process)
NATS_URL=
NATS_QUEUE_GROUP=bookmarks-worker
